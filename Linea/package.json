{
  "name": "linea",
  "version": "0.2.0-beta.1",
  "description": "Always-on-top lyrics overlay for Windows media sessions",
  "main": "./out/main/index.js",
  "author": "Meet2304",
  "license": "MIT",
  "homepage": "https://github.com/Meet2304/Project-Linea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet2304/Project-Linea.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "bun run build:smtc && electron-vite dev",
    "build": "bun run build:smtc && bun run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/package.mjs --dir",
    "build:win": "npm run build && node scripts/package.mjs --win",
    "build:mac": "npm run build && node scripts/package.mjs --mac",
    "build:linux": "npm run build && node scripts/package.mjs --linux",
    "dist": "bun run build && node scripts/package.mjs",
    "dist:mac": "bun run build && node scripts/package.mjs --mac",
    "dist:win": "bun run build && node scripts/package.mjs --win",
    "release": "bun run build && node scripts/package.mjs --publish always",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:smtc": "node scripts/build-smtc.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.9"
  }
}
